{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint/",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/js/tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test:ci",
    "audit": "yarn audit --level high",
    "lighthouse": "npx lighthouse http://localhost:8081/ --chrome-flags=\"--headless\" --output=html --output-path=./lighthouse.html"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/node": "24",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
