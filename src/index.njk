---
layout: base.njk
title: Home
---
<section class="home-hero">
  <img
    class="home-hero__image rise-in"
    src="/img/hero.jpg"
    alt="{% if resume.name %}{{ resume.name }}{% else %}Hero photo{% endif %}"
    width="1066"
    height="1600"
  >

  <div class="home-hero__copy">
    <h1 class="home-hero__name rise-in rise-in--delay-1">{{ resume.name }}</h1>
    <p class="home-hero__role rise-in rise-in--delay-1">{{ resume.title }}</p>
    <p class="home-hero__welcome rise-in rise-in--delay-2">
      Welcome. I build and secure cloud and application infrastructure in Singapore.
      Resume, writing, and LinkedIn are below if you want to dig in.
    </p>
    {% if resume.location %}
    <p class="home-hero__location meta rise-in rise-in--delay-2">{{ resume.location }}</p>
    {% endif %}
    <ul class="home-hero__ctas rise-in rise-in--delay-3">
      <li><a href="/resume/">Resume</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/write-ups/">Write-Ups</a></li>
      {% if resume.linkedin %}
      <li>
        <a class="home-hero__external" href="{{ resume.linkedin }}" target="_blank" rel="noopener noreferrer">
          LinkedIn
          <svg class="icon-external" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M10.5 1H7v1h1.8L5.15 5.65l.7.7L9.5 2.7V4.5H10.5V1zM2 2v8h8V7H9v2H3V3h2V2H2z"/>
          </svg>
        </a>
      </li>
      {% endif %}
    </ul>
  </div>
</section>
