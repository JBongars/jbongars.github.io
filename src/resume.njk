---
layout: base.njk
title: Resume
permalink: /resume/
---
<article class="resume">
  <header class="resume__intro">
    <h1 class="rise-in">{{ resume.name }}</h1>
    <p class="resume__role">{{ resume.title }}</p>
    {% if resume.location %}
    <p class="resume__location meta">{{ resume.location }}</p>
    {% endif %}
    <ul class="resume__links">
      {% if resume.linkedin %}
      <li><a href="{{ resume.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      {% endif %}
      {% if resume.github %}
      <li><a href="{{ resume.github }}" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      {% endif %}
    </ul>
  </header>

  <div class="resume__layout">
    <div class="resume__main">
      {% if resume.experience and resume.experience.length %}
      <section class="resume__section" aria-labelledby="experience-heading">
        <h2 class="rise-in" id="experience-heading">Experience</h2>
        {% for role in resume.experience %}
        <article class="resume-role">
          <header class="resume-role__header">
            <h3 class="resume-role__title">{{ role.title }}</h3>
            <p class="resume-role__company">
              {{ role.company }}{% if role.agency %} <span class="resume-role__agency">(via {{ role.agency }})</span>{% endif %}
            </p>
            <p class="resume-role__meta meta">
              {{ role.start }}–{{ role.end }}{% if role.location %} · {{ role.location }}{% endif %}{% if role.duration %} · {{ role.duration }}{% endif %}
            </p>
          </header>
          {% if role.bullets and role.bullets.length %}
          <ul class="resume-role__bullets">
            {% for bullet in role.bullets %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if role.tools and role.tools.length %}
          <ul class="tag-list" aria-label="Tools">
            {% for tool in role.tools %}
            <li class="tag">{{ tool }}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </article>
        {% endfor %}
      </section>
      {% endif %}

      {% if resume.societies and resume.societies.length %}
      <section class="resume__section" aria-labelledby="societies-heading">
        <h2 class="rise-in" id="societies-heading">Societies</h2>
        {% for society in resume.societies %}
        <article class="resume-item">
          <h3 class="resume-item__title">{{ society.name }}</h3>
          <p class="resume-item__detail">
            {% if society.role %}{{ society.role }}{% endif %}{% if society.role and society.since %} · {% endif %}{% if society.since %}since {{ society.since }}{% endif %}
          </p>
        </article>
        {% endfor %}
      </section>
      {% endif %}
    </div>

    <aside class="resume__sidebar">
      {% if resume.biography %}
      <section class="resume__section" aria-labelledby="biography-heading">
        <h2 class="rise-in" id="biography-heading">Biography</h2>
        <p class="resume__bio">{{ resume.biography }}</p>
      </section>
      {% endif %}

      {% if resume.skills and resume.skills.length %}
      <section class="resume__section" aria-labelledby="skills-heading">
        <h2 class="rise-in" id="skills-heading">Skills</h2>
        <ul class="tag-list">
          {% for skill in resume.skills %}
          <li class="tag">{{ skill }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      {% if resume.education and resume.education.length %}
      <section class="resume__section" aria-labelledby="education-heading">
        <h2 class="rise-in" id="education-heading">Education</h2>
        {% for item in resume.education %}
        <article class="resume-item">
          <h3 class="resume-item__title">{{ item.institution }}</h3>
          <p class="resume-item__detail">{{ item.program }}</p>
          {% if item.dates %}
          <p class="meta">{{ item.dates }}</p>
          {% endif %}
        </article>
        {% endfor %}
      </section>
      {% endif %}

      {% if resume.certificates and resume.certificates.length %}
      <section class="resume__section" aria-labelledby="certificates-heading">
        <h2 class="rise-in" id="certificates-heading">Certificates</h2>
        {% for cert in resume.certificates %}
        <article class="resume-item">
          <h3 class="resume-item__title">{{ cert.name }}</h3>
          <p class="resume-item__detail">
            {% if cert.issuer %}{{ cert.issuer }}{% endif %}{% if cert.issuer and cert.year %} · {% endif %}{% if cert.year %}{{ cert.year }}{% endif %}{% if cert.status %} · {{ cert.status }}{% endif %}
          </p>
        </article>
        {% endfor %}
      </section>
      {% endif %}

      {% if resume.references and resume.references.length %}
      <section class="resume__section" aria-labelledby="references-heading">
        <h2 class="rise-in" id="references-heading">References</h2>
        {% for ref in resume.references %}
        <article class="resume-item">
          <h3 class="resume-item__title">{{ ref.name }}</h3>
          {% if ref.detail or ref.title or ref.contact %}
          <p class="resume-item__detail">
            {% if ref.title %}{{ ref.title }}{% endif %}{% if ref.title and ref.detail %} · {% endif %}{% if ref.detail %}{{ ref.detail }}{% endif %}{% if (ref.title or ref.detail) and ref.contact %} · {% endif %}{% if ref.contact %}{{ ref.contact }}{% endif %}
          </p>
          {% endif %}
        </article>
        {% endfor %}
      </section>
      {% elif resume.references %}
      <section class="resume__section" aria-labelledby="references-heading">
        <h2 class="rise-in" id="references-heading">References</h2>
        <p class="resume-item__detail">{{ resume.references }}</p>
      </section>
      {% endif %}
    </aside>
  </div>
</article>
