<!DOCTYPE html>
<html lang="en" data-path-prefix="{{ pathPrefix }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="{{ security.contentSecurityPolicy | safe }}">
  <meta name="referrer" content="{{ security.referrerPolicy }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ cssRev }}" fetchpriority="high">
  <title>{% if title %}{{ title }} · {% endif %}{{ resume.name }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta name="author" content="{{ resume.name }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <link rel="describedby" href="{{ '/llms.txt' | absoluteUrl }}" type="text/markdown">
  <link rel="alternate" type="application/rss+xml" title="{{ resume.name }}" href="{{ '/feed.xml' | absoluteUrl }}">
  {% if page.url == "/resume/" %}
  <link rel="alternate" type="application/json" title="JSON Resume" href="{{ '/resume.json' | absoluteUrl }}">
  {% endif %}
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ resume.name }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{% if (page.url != '/blog/' and '/blog/' in page.url) or (page.url != '/write-ups/' and '/write-ups/' in page.url) %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:image" content="{{ '/img/hero.jpg' | absoluteUrl }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} · {% endif %}{{ resume.name }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="{{ '/img/hero.jpg' | absoluteUrl }}">
  <script type="application/ld+json">{{ collections | jsonLdGraph | safe }}</script>
  <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon/favicon-32x32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/favicon/favicon-16x16.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/favicon/apple-touch-icon.png' | url }}">
  <link rel="manifest" href="{{ '/favicon/site.webmanifest' | url }}">
  <meta name="theme-color" content="#12161c">
  <meta name="color-scheme" content="dark light">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-brand" href="{{ '/' | url }}">{% if resume.name %}{{ resume.name }}{% else %}Home{% endif %}</a>

      <div class="site-header__actions">
        <input type="checkbox" id="theme-toggle" class="theme-toggle">
        <script>{{ security.themeInitScript | safe }}</script>
        <label for="theme-toggle" class="theme-toggle-btn">
          <svg class="theme-toggle-btn__icon theme-toggle-btn__icon--to-light" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zm0 1.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zM7.25 1h1.5v2h-1.5V1zm0 12h1.5v2h-1.5v-2zM1 7.25h2v1.5H1v-1.5zm12 0h2v1.5h-2v-1.5zM3.05 3.05l1.06 1.06-1.06 1.06-1.06-1.06 1.06-1.06zm9.9 9.9l1.06 1.06-1.06 1.06-1.06-1.06 1.06-1.06zm0-9.9l1.06 1.06-1.06 1.06-1.06-1.06L12.95 3.05zM3.05 12.95l1.06 1.06-1.06 1.06-1.06-1.06 1.06-1.06z"/>
          </svg>
          <svg class="theme-toggle-btn__icon theme-toggle-btn__icon--to-dark" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M6 1.5A6.5 6.5 0 1 0 14.2 10 5.2 5.2 0 1 1 6 1.5z"/>
          </svg>
          <span class="visually-hidden">Toggle light and dark mode</span>
        </label>

        <input type="checkbox" id="nav-toggle" class="nav-toggle">
        <label for="nav-toggle" class="nav-toggle-btn">
          <span class="nav-toggle-btn__box" aria-hidden="true">
            <span class="nav-toggle-btn__bar"></span>
            <span class="nav-toggle-btn__bar"></span>
            <span class="nav-toggle-btn__bar"></span>
          </span>
          <span class="visually-hidden">Menu</span>
        </label>
      </div>

      <nav class="site-nav" aria-label="Primary">
        <ul class="nav-list">
          <li>
            <a href="{{ '/' | url }}" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a>
          </li>
          <li>
            <a href="{{ '/resume/' | url }}" {% if page.url == "/resume/" %}aria-current="page"{% endif %}>Resume</a>
          </li>
          <li>
            <a href="{{ '/blog/' | url }}" {% if "/blog/" in page.url %}aria-current="page"{% endif %}>Blog</a>
          </li>
          <li>
            <a href="{{ '/write-ups/' | url }}" {% if "/write-ups/" in page.url %}aria-current="page"{% endif %}>Write-Ups</a>
          </li>
          {% if features.hacklas %}
          <li>
            <a href="{{ '/hacklas/' | url }}" {% if "/hacklas/" in page.url %}aria-current="page"{% endif %}>Hacklas{% include "hacklas-beta-badge.njk" %}</a>
          </li>
          {% endif %}
          {% if resume.linkedin %}
          <li>
            <a
              class="nav-list__external"
              href="{{ resume.linkedin }}"
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="LinkedIn"
            >
              <span class="nav-list__external-label">LinkedIn</span>
              <img
                class="nav-list__external-icon"
                src="{{ '/img/linkedin.svg' | url }}"
                alt=""
                width="16"
                height="16"
                eleventy:ignore
              >
              <svg class="icon-external" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M10.5 1H7v1h1.8L5.15 5.65l.7.7L9.5 2.7V4.5H10.5V1zM2 2v8h8V7H9v2H3V3h2V2H2z"/>
              </svg>
            </a>
          </li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <img
      class="site-footer__signature"
      src="{{ '/img/signature.svg' | url }}"
      alt="{% if resume.name %}{{ resume.name }}{% else %}Signature{% endif %}"
      width="215"
      height="97"
      eleventy:ignore
    >
    <div class="site-footer__meta">
      <p class="site-footer__copy">&copy; {% year %}{% if resume.name %} {{ resume.name }}{% endif %}</p>
      {% if resume.github or resume.linkedin %}
      <ul class="site-footer__socials" aria-label="Social links">
        {% if resume.github %}
        <li>
          <a href="{{ resume.github }}" target="_blank" rel="me noopener noreferrer" aria-label="GitHub">
            <img class="social-icon" src="{{ '/img/github.svg' | url }}" alt="" width="20" height="20" eleventy:ignore>
          </a>
        </li>
        {% endif %}
        {% if resume.linkedin %}
        <li>
          <a href="{{ resume.linkedin }}" target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn">
            <img class="social-icon" src="{{ '/img/linkedin.svg' | url }}" alt="" width="20" height="20" eleventy:ignore>
          </a>
        </li>
        {% endif %}
      </ul>
      {% endif %}
    </div>
  </footer>
  {% set isListing = page.url == "/blog/" or page.url == "/write-ups/" %}
  {% set isPost = (page.url != "/blog/" and "/blog/" in page.url) or (page.url != "/write-ups/" and "/write-ups/" in page.url) or (page.url != "/hacklas/" and "/hacklas/" in page.url) %}
  {% if isListing %}
  <script src="{{ '/js/booru-search.js' | url }}" defer></script>
  {% endif %}
  {% if features.hacklas %}
  {# Loaded on every page so site.js main-swaps onto /hacklas/ still have handlers. #}
  <script src="{{ '/js/site-url.js' | url }}" defer></script>
  <script src="{{ '/js/fuzzy-find.js' | url }}" defer></script>
  <script src="{{ '/js/hacklas-disclaimer.js' | url }}" defer></script>
  {% endif %}
  {% if isPost %}
  <script src="{{ '/js/code-blocks.js' | url }}" defer></script>
  <script src="{{ '/js/image-lightbox.js' | url }}" defer></script>
  <script src="{{ '/js/back-button.js' | url }}" defer></script>
  {% if comments.enabled %}
  <script src="{{ '/js/comments.js' | url }}" defer></script>
  {% endif %}
  {% endif %}
  <script src="{{ '/js/site.js' | url }}" defer></script>
</body>
</html>
