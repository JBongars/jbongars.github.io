<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }}{% else %}Personal Site{% endif %}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav aria-label="Primary">
      <ul class="nav-list">
        <li><a href="/">Home</a></li>
        <li><a href="/resume/">Resume</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/write-ups/">Write-Ups</a></li>
        {% if resume.linkedin %}
        <li><a href="{{ resume.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        {% endif %}
      </ul>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <p>{% if resume.name %}{{ resume.name }}{% else %}Site name placeholder{% endif %}</p>
  </footer>
</body>
</html>
