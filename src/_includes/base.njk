<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }}{% else %}Personal Site{% endif %}</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/favicon/site.webmanifest">
  <meta name="theme-color" content="#12161c">
  <meta name="color-scheme" content="dark light">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-brand" href="/">{% if resume.name %}{{ resume.name }}{% else %}Home{% endif %}</a>

      <div class="site-header__actions">
        <input type="checkbox" id="theme-toggle" class="theme-toggle">
        <script>
          try {
            if (localStorage.getItem("theme") === "light") {
              document.getElementById("theme-toggle").checked = true;
            }
          } catch (e) {}
        </script>
        <label for="theme-toggle" class="theme-toggle-btn">
          <svg class="theme-toggle-btn__icon theme-toggle-btn__icon--to-light" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zm0 1.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zM7.25 1h1.5v2h-1.5V1zm0 12h1.5v2h-1.5v-2zM1 7.25h2v1.5H1v-1.5zm12 0h2v1.5h-2v-1.5zM3.05 3.05l1.06 1.06-1.06 1.06-1.06-1.06 1.06-1.06zm9.9 9.9l1.06 1.06-1.06 1.06-1.06-1.06 1.06-1.06zm0-9.9l1.06 1.06-1.06 1.06-1.06-1.06L12.95 3.05zM3.05 12.95l1.06 1.06-1.06 1.06-1.06-1.06 1.06-1.06z"/>
          </svg>
          <svg class="theme-toggle-btn__icon theme-toggle-btn__icon--to-dark" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M6 1.5A6.5 6.5 0 1 0 14.2 10 5.2 5.2 0 1 1 6 1.5z"/>
          </svg>
          <span class="visually-hidden">Toggle light and dark mode</span>
        </label>

        <input type="checkbox" id="nav-toggle" class="nav-toggle">
        <label for="nav-toggle" class="nav-toggle-btn">
          <span class="nav-toggle-btn__box" aria-hidden="true">
            <span class="nav-toggle-btn__bar"></span>
            <span class="nav-toggle-btn__bar"></span>
            <span class="nav-toggle-btn__bar"></span>
          </span>
          <span class="visually-hidden">Menu</span>
        </label>
      </div>

      <nav class="site-nav" aria-label="Primary">
        <ul class="nav-list">
          <li>
            <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a>
          </li>
          <li>
            <a href="/resume/" {% if page.url == "/resume/" %}aria-current="page"{% endif %}>Resume</a>
          </li>
          <li>
            <a href="/blog/" {% if "/blog/" in page.url %}aria-current="page"{% endif %}>Blog</a>
          </li>
          <li>
            <a href="/write-ups/" {% if "/write-ups/" in page.url %}aria-current="page"{% endif %}>Write-Ups</a>
          </li>
          {% if features.hacklas %}
          <li>
            <a href="/hacklas/" {% if "/hacklas/" in page.url %}aria-current="page"{% endif %}>Hacklas</a>
          </li>
          {% endif %}
          {% if resume.linkedin %}
          <li>
            <a
              class="nav-list__external"
              href="{{ resume.linkedin }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <span class="nav-list__external-label">LinkedIn</span>
              <img
                class="nav-list__external-icon"
                src="/img/linkedin.svg"
                alt=""
                width="16"
                height="16"
              >
              <svg class="icon-external" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M10.5 1H7v1h1.8L5.15 5.65l.7.7L9.5 2.7V4.5H10.5V1zM2 2v8h8V7H9v2H3V3h2V2H2z"/>
              </svg>
            </a>
          </li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <img
      class="site-footer__signature"
      src="/img/signature.svg"
      alt="{% if resume.name %}{{ resume.name }}{% else %}Signature{% endif %}"
      width="215"
      height="97"
    >
    <div class="site-footer__meta">
      <p class="site-footer__copy">&copy; {% year %}{% if resume.name %} {{ resume.name }}{% endif %}</p>
      {% if resume.github or resume.linkedin %}
      <ul class="site-footer__socials" aria-label="Social links">
        {% if resume.github %}
        <li>
          <a href="{{ resume.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <img class="social-icon" src="/img/github.svg" alt="" width="20" height="20">
          </a>
        </li>
        {% endif %}
        {% if resume.linkedin %}
        <li>
          <a href="{{ resume.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <img class="social-icon" src="/img/linkedin.svg" alt="" width="20" height="20">
          </a>
        </li>
        {% endif %}
      </ul>
      {% endif %}
    </div>
  </footer>
  <script src="/js/booru-search.js" defer></script>
  {% if features.hacklas %}
  <script src="/js/fuzzy-find.js" defer></script>
  <script src="/js/hacklas-disclaimer.js" defer></script>
  {% endif %}
  <script src="/js/back-button.js" defer></script>
  <script src="/js/site.js" defer></script>
</body>
</html>
