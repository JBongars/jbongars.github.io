---
layout: base.njk
---
{% set tocHtml = content | toc %}
{% set bodyHtml = content | stripNoteChrome %}
<div class="note-bar">
  <a class="back-button" href="{{ '/hacklas/' | url }}" data-back>← Back</a>
  {% if notePathParts and notePathParts.length %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a class="breadcrumbs__link" href="{{ '/hacklas/' | url }}">Hacklas{% include "hacklas-beta-badge.njk" %}</a>
    {% for part in notePathParts %}
    <span class="breadcrumbs__sep" aria-hidden="true">/</span>
    {% if loop.last %}
    <span class="breadcrumbs__current" aria-current="page">{{ part }}</span>
    {% else %}
    <a class="breadcrumbs__link" href="{{ '/hacklas/' | url }}?q={{ notePathParts.slice(0, loop.index) | join('/') | urlencode }}">{{ part }}</a>
    {% endif %}
    {% endfor %}
  </nav>
  {% endif %}
</div>
<article class="note post--with-toc">
  <nav class="toc" aria-label="Table of contents">
    {% if tocHtml %}
    {{ tocHtml | safe }}
    {% else %}
    <p class="toc__empty"><em>no index available</em></p>
    {% endif %}
  </nav>
  <div class="post__body">
    <header class="post__header">
      <h1 class="post__title">{{ title }}</h1>
      {% if author or date or noteTags %}
      <dl class="post__facts">
        {% if author %}
        <div class="post__fact">
          <dt>Author</dt>
          <dd>{{ author }}</dd>
        </div>
        {% endif %}
        {% if date %}
        <div class="post__fact">
          <dt>Date</dt>
          <dd><time datetime="{{ date.toISOString().slice(0, 10) }}">{{ date.toISOString().slice(0, 10) }}</time></dd>
        </div>
        {% endif %}
        {% if noteTags and noteTags.length %}
        <div class="post__fact post__fact--tags">
          <dt>Tags</dt>
          <dd>
            <ul class="tag-list">
              {% for tag in noteTags %}
              <li><a class="tag tag--link" href="{{ '/hacklas/' | url }}?t={{ tag | urlencode }}">{{ tag }}</a></li>
              {% endfor %}
            </ul>
          </dd>
        </div>
        {% endif %}
      </dl>
      {% endif %}
    </header>
    <div class="prose">
      {{ bodyHtml | safe }}
    </div>
  </div>
</article>
{% include "comments.njk" %}
{% include "hacklas-disclaimer.njk" %}
