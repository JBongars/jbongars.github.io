---
layout: base.njk
title: Write-Ups
permalink: /write-ups/
---
<h1>Write-Ups</h1>

{% if collections.writeUps.length %}
<ul class="card-grid post-list">
  {% for writeup in collections.writeUps %}
  <li class="card">
    <h2 class="card__title">
      <a href="{{ writeup.url }}">{{ writeup.data.title or writeup.fileSlug }}</a>
    </h2>
    {% if writeup.date %}
    <p class="card__meta">
      <time datetime="{{ writeup.date.toISOString().slice(0, 10) }}">{{ writeup.date.toISOString().slice(0, 10) }}</time>
    </p>
    {% endif %}
  </li>
  {% endfor %}
</ul>
{% else %}
<p>No write-ups yet.</p>
{% endif %}
