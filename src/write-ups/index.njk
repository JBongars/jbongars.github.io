---
layout: base.njk
title: Write-Ups
permalink: /write-ups/
---
<h1>Write-Ups</h1>

{% if collections.writeUps.length %}
<ul class="card-grid post-list" data-sortable-list>
  {% for writeup in collections.writeUps %}
  <li
    data-title="{{ writeup.data.title or writeup.fileSlug }}"
    {% if writeup.date %}data-date="{{ writeup.date.toISOString() }}"{% endif %}
    {% if writeup.data.tags and writeup.data.tags.length %}data-tags="{{ writeup.data.tags | join(',') }}"{% endif %}
  >
    <a class="card card--with-media" href="{{ writeup.url }}">
      <div class="card__media{% if not writeup.data.banner %} card__media--fallback{% endif %}">
        {% if writeup.data.banner %}
        <img src="{{ writeup.data.banner }}" alt="" width="1280" height="720" loading="lazy" decoding="async">
        {% endif %}
      </div>
      <h2 class="card__title">{{ writeup.data.title or writeup.fileSlug }}</h2>
      <dl class="card__facts">
        {% if writeup.data.author %}
        <div class="card__fact">
          <dt>Author</dt>
          <dd>{{ writeup.data.author }}</dd>
        </div>
        {% endif %}
        {% if writeup.date %}
        <div class="card__fact">
          <dt>Date</dt>
          <dd>
            <time datetime="{{ writeup.date.toISOString().slice(0, 10) }}">{{ writeup.date.toISOString().slice(0, 10) }}</time>
          </dd>
        </div>
        {% endif %}
        {% if writeup.data.path %}
        <div class="card__fact">
          <dt>Path</dt>
          <dd><code>{{ writeup.data.path }}</code></dd>
        </div>
        {% endif %}
        {% if writeup.data.tags and writeup.data.tags.length %}
        <div class="card__fact card__fact--tags">
          <dt>Tags</dt>
          <dd>
            <ul class="tag-list">
              {% for tag in writeup.data.tags %}
              <li><span class="tag">{{ tag }}</span></li>
              {% endfor %}
            </ul>
          </dd>
        </div>
        {% endif %}
      </dl>
    </a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p>No write-ups yet.</p>
{% endif %}
